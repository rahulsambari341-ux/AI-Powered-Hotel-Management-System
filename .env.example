# Copy this file to .env and fill in real values.
# NEVER commit .env itself.

# --- Database ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_ROOT_PASSWORD=

# --- App ---
APP_ENV=development

# --- AI / LLM ---
OPENAI_API_KEY=

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b-instruct

# --- Telephony ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
PUBLIC_BASE_URL=http://localhost:8000

# --- Notifications ---
TWILIO_SMS_FROM_NUMBER=

# --- Email / SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# --- Shared state ---
REDIS_URL=
SESSION_TTL_SECONDS=3600
AUDIO_CACHE_TTL_SECONDS=300

# --- Security ---
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,null
RATE_LIMIT_ENABLED=false
ADMIN_TOKEN=